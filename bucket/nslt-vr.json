{
    "version": "1.1.0",
    "description": "VR mod for New Super Lucky's Tale (Steam): play it in a SteamVR headset with motion controllers.",
    "homepage": "https://github.com/technewsguy/NSLT-VR",
    "license": "MIT",
    "notes": [
        "NSLT-VR is installed into your New Super Lucky's Tale folder (found through Steam).",
        "Play from Steam's normal 'New Super Lucky's Tale' entry: it starts in VR, and is listed in SteamVR's VR library tab after Steam next restarts.",
        "Game in an unusual place? Set the NSLTVR_GAMEDIR environment variable to its folder and install again.",
        "Install log: %TEMP%\\nsltvr-setup.log"
    ],
    "url": "https://github.com/technewsguy/NSLT-VR/releases/download/v1.1.0/NSLT-VR-v1.1.0.zip",
    "hash": "89e331a6019763107817fbca7e4f335ea67036329ead56d88ea380a6721b744d",
    "extract_dir": "NSLT-VR-v1.1.0",
    "installer": {
        "script": [
            "$a = @('/S')",
            "if ($env:NSLTVR_GAMEDIR) { $a += \"/GAMEDIR=`\"$env:NSLTVR_GAMEDIR`\"\" }",
            "$p = Start-Process \"$dir\\NSLT-VR-Setup.exe\" -ArgumentList $a -Wait -PassThru",
            "Get-Content \"$env:TEMP\\nsltvr-setup.log\" -ErrorAction SilentlyContinue | Write-Host",
            "if ($p.ExitCode -ne 0) { throw 'NSLT-VR setup failed (see the log above).' }"
        ]
    },
    "uninstaller": {
        "script": [
            "# On update the new version's installer simply installs over the old one; only a real uninstall removes the mod.",
            "if (($subCommand -eq 'uninstall') -or ($cmd -eq 'uninstall')) {",
            "    $a = @('/S', '/UNINSTALL')",
            "    if ($env:NSLTVR_GAMEDIR) { $a += \"/GAMEDIR=`\"$env:NSLTVR_GAMEDIR`\"\" }",
            "    $p = Start-Process \"$dir\\NSLT-VR-Setup.exe\" -ArgumentList $a -Wait -PassThru",
            "    Get-Content \"$env:TEMP\\nsltvr-setup.log\" -ErrorAction SilentlyContinue | Write-Host",
            "}"
        ]
    },
    "checkver": {
        "github": "https://github.com/technewsguy/NSLT-VR"
    },
    "autoupdate": {
        "url": "https://github.com/technewsguy/NSLT-VR/releases/download/v$version/NSLT-VR-v$version.zip",
        "extract_dir": "NSLT-VR-v$version"
    }
}
